# Nusxalab .env deb saqlang: cp .env.example .env
# Yangi SECRET_KEY generatsiya qilish:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=your-secret-key-here
DEBUG=True
USE_SQLITE=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (USE_SQLITE=False bo'lganda ishlatiladi)
POSTGRES_DB=fileflow
POSTGRES_USER=fileflow
POSTGRES_PASSWORD=fileflow_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1